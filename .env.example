# KernelPulse — Environment Configuration
# Copy this file to .env and adjust values before starting the server.

# -- Server ------------------------------------------------------------
PORT=8080
HOST=0.0.0.0

# -- AI Module ---------------------------------------------------------
# Number of data points collected before anomaly detection activates
AI_LEARNING_SAMPLES=20

# Z-score threshold for WARNING status (standard deviations from baseline)
AI_ZSCORE_WARNING=2.0

# Z-score threshold for ANOMALY status
AI_ZSCORE_ANOMALY=3.0

# Enable Isolation Forest second-pass (requires: pip install scikit-learn)
AI_USE_ISOLATION_FOREST=false

# Rolling window size (number of data points kept in memory per metric)
AI_WINDOW_SIZE=60

# -- Optional Alerting (v1.1.0 planned) --------------------------------
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# ALERT_EMAIL=admin@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
